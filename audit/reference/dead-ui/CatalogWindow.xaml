<Window
    x:Class="VitanCut.WinUI.Views.CatalogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Каталог">

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource WindowPagePadding}">
    <Border Style="{StaticResource PaneSurfaceStyle}">
      <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
        <SymbolIcon Symbol="Library" />
        <TextBlock Text="Каталог изделий" Style="{StaticResource SectionTitleTextBlockStyle}" TextAlignment="Center" />
        <TextBlock Text="Окно каталога заведено отдельно. Следующим проходом перенесу сюда логику шаблонов изделий из веб-версии."
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Style="{StaticResource MutedTextBlockStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
