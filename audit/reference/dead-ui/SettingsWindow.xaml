<Window
    x:Class="VitanCut.WinUI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройки">

  <Grid x:Name="Root" Padding="{StaticResource WindowPagePadding}" ColumnSpacing="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource PaneSurfaceStyle}">
      <NavigationView IsSettingsVisible="False"
                      PaneDisplayMode="LeftCompact"
                      IsBackButtonVisible="Collapsed"
                      SelectionChanged="SettingsSectionChanged">
        <NavigationView.MenuItems>
          <NavigationViewItem Content="Внешний вид" Tag="appearance" IsSelected="True">
            <NavigationViewItem.Icon>
              <SymbolIcon Symbol="Edit" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Раскрой" Tag="cutting">
            <NavigationViewItem.Icon>
              <SymbolIcon Symbol="Crop" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Деталировка" Tag="detailing">
            <NavigationViewItem.Icon>
              <SymbolIcon Symbol="List" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
        </NavigationView.MenuItems>
      </NavigationView>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}">
      <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="760">
          <StackPanel x:Name="AppearancePanel" Spacing="18">
            <TextBlock Text="Внешний вид" Style="{StaticResource SectionTitleTextBlockStyle}" />
            <TextBlock Text="Тема и акцент повторяют подход Fluent: акцент используется для основного действия, выбранных элементов и интерактивных состояний."
                       Style="{StaticResource MutedTextBlockStyle}" />

            <ComboBox x:Name="ThemeBox" Header="Тема" SelectionChanged="ThemeChanged" MinWidth="260">
              <ComboBoxItem Content="Авто" Tag="auto" />
              <ComboBoxItem Content="Светлая" Tag="light" />
              <ComboBoxItem Content="Темная" Tag="dark" />
            </ComboBox>

            <ComboBox x:Name="AccentBox" Header="Акцентный цвет приложения" SelectionChanged="AccentChanged" MinWidth="260" />
          </StackPanel>

          <StackPanel x:Name="CuttingPanel" Visibility="Collapsed" Spacing="14">
            <TextBlock Text="Раскрой" Style="{StaticResource SectionTitleTextBlockStyle}" />
            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="Настройки будут добавлены"
                     Message="Сюда вынесем параметры раскроя после твоей спецификации: припуски, поворот, направление текстуры, алгоритм раскладки и печатные формы." />
          </StackPanel>

          <StackPanel x:Name="DetailingPanel" Visibility="Collapsed" Spacing="14">
            <TextBlock Text="Деталировка" Style="{StaticResource SectionTitleTextBlockStyle}" />
            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="Настройки будут добавлены"
                     Message="Сюда вынесем правила деталировки после твоей спецификации: шаблоны деталей, формулы, кромку, группировку и вывод ведомостей." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
