<Application x:Class="VitanCut.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
      <x:Double x:Key="UiBodySize">14</x:Double>
      <x:Double x:Key="UiCaptionSize">12</x:Double>
      <x:Double x:Key="UiSectionSize">16</x:Double>
      <x:Double x:Key="UiPageSize">24</x:Double>
      <Thickness x:Key="UiControlPadding">12,8</Thickness>
      <Thickness x:Key="UiSectionPadding">16</Thickness>
      <CornerRadius x:Key="UiControlRadius">6</CornerRadius>
      <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiBodySize}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
      </Style>
      <Thickness x:Key="WindowPagePadding">24</Thickness>
      <ThemeShadow x:Key="SurfaceShadow" />
      <LinearGradientBrush x:Key="PaneGlassBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#FEFFFFFF" Offset="0" />
        <GradientStop Color="#F0F4F7FA" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#006CE0" Offset="0" />
        <GradientStop Color="#004BA0" Offset="1" />
      </LinearGradientBrush>
      <!-- Shared brushes are mutated, never replaced after native templates load. -->
      <SolidColorBrush x:Key="PageSurfaceBrush" Color="#D8CCD5DE" />
      <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#F8FFFFFF" />
      <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#E8E3EAF0" />
      <SolidColorBrush x:Key="SectionSurfaceBrush" Color="#EDF1F5" />
      <SolidColorBrush x:Key="SoftPanelBrush" Color="#E5EBF0" />
      <SolidColorBrush x:Key="PanelStrokeBrush" Color="#70808B96" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#172025" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="AppAccentTextBrush" Color="#0057B8" />
      <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppSelectionBrush" Color="#22006CE0" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="#FFF4CE" />
      <SolidColorBrush x:Key="UiDangerBrush" Color="#B42318" />
      <SolidColorBrush x:Key="UiSuccessBrush" Color="#087443" />
      <SolidColorBrush x:Key="UiWarningTextBrush" Color="#97600F" />
      <SolidColorBrush x:Key="MetricAreaBrush" Color="#087E74" />
      <SolidColorBrush x:Key="MetricMaterialBrush" Color="#63737D" />
      <SolidColorBrush x:Key="MetricPayrollBrush" Color="#97600F" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#A0FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E0FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B8E5ECF0" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#38808B96" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#68808B96" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#D8FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F0FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#48808B96" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#70808B96" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#006CE0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#006CE0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#006CE0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#006CE0" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ComboBoxItemSelectionIndicatorBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#22006CE0" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#22006CE0" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#22006CE0" />
      <AcrylicBrush x:Key="GlassChromeBrush" TintColor="#F4F7F9" TintOpacity="0.7" TintLuminosityOpacity="0.85" FallbackColor="#F4F7F9" />
      <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0.75,1">
        <GradientStop Color="#DCFFFFFF" Offset="0" />
        <GradientStop Color="#40798490" Offset="0.45" />
        <GradientStop Color="#10808A94" Offset="0.75" />
        <GradientStop Color="#A0FFFFFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="MetricSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8FFFFFF" Offset="0" />
        <GradientStop Color="#A8EDF2F5" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90FFFFFF" Offset="0" />
        <GradientStop Color="#08000000" Offset="0.4" />
        <GradientStop Color="#28000000" Offset="1" />
      </LinearGradientBrush>
    <Style x:Key="AppTitleTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource UiPageSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitleTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource UiSectionSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PaneSurfaceStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PaneGlassBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SidebarSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PaneSurfaceStyle}">
      <Setter Property="Background" Value="{StaticResource SidebarSurfaceBrush}" />
    </Style>
    <Style x:Key="SettingsSectionStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SectionSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="MaterialSplitterStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="MetricSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PaneSurfaceStyle}">
      <Setter Property="Background" Value="{StaticResource SectionSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="ListSurfaceStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SoftPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <DataTemplate x:Key="FormulaReferenceTemplate">
      <Grid ColumnSpacing="12" RowSpacing="2" Padding="0,4" ToolTipService.ToolTip="{Binding Label}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Section}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MaterialPickerTemplate">
      <StackPanel Spacing="2" Padding="0,4">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <Style x:Key="UiButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="{StaticResource UiBodySize}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="{StaticResource UiControlPadding}" />
      <Setter Property="CornerRadius" Value="{StaticResource UiControlRadius}" />
    </Style>
    <Style x:Key="CommandLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource UiBodySize}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource UiButtonStyle}" />
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource UiButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AppOnAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="CatalogInfoButtonStyle" TargetType="Button" BasedOn="{StaticResource UiButtonStyle}">
      <Setter Property="Tag" Value="icon-tool" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="InfoSurface" CornerRadius="14" Background="Transparent" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" Opacity="0.55">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="InfoSurface.Opacity" Value="1"/><Setter Target="InfoSurface.Background" Value="{StaticResource SoftPanelBrush}"/></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="InfoSurface.Opacity" Value="0.8"/><Setter Target="InfoSurface.Background" Value="{StaticResource ButtonBackgroundPressed}"/></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="InfoSurface.Opacity" Value="0.3"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <PathIcon Data="M 7,1 A 1.5,1.5 0 1 1 4,1 A 1.5,1.5 0 1 1 7,1 Z M 4.5,5 L 6.5,5 L 6.5,13 L 4.5,13 Z" Width="12" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CatalogSegmentStyle" TargetType="RadioButton">
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="SegmentSurface" Background="Transparent" CornerRadius="4">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SegmentSurface.Background" Value="{StaticResource SoftPanelBrush}"/></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SegmentSurface.Opacity" Value="0.75"/></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SegmentSurface.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="SelectedSurface.Opacity" Value="1"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="SelectedSurface" Opacity="0" Background="{StaticResource ButtonBackground}" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="4" />
              <ContentPresenter Content="{TemplateBinding Content}" Margin="12,5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource UiButtonStyle}" />
    <Style x:Key="TopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource IconTextButtonStyle}">
      <Setter Property="Width" Value="86" />
      <Setter Property="Height" Value="76" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AccentTopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource AppOnAccentBrush}" />
    </Style>
    <Style x:Key="SettingsTopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
      <Setter Property="Width" Value="86" />
    </Style>
    <Style x:Key="AccentSettingsTopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentTopNavButtonStyle}">
      <Setter Property="Width" Value="86" />
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
