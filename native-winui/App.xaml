<Application x:Class="VitanCut.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
      <Thickness x:Key="WindowPagePadding">24</Thickness>
      <ThemeShadow x:Key="SurfaceShadow" />
      <LinearGradientBrush x:Key="PaneGlassBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#FEFFFFFF" Offset="0" />
        <GradientStop Color="#F0F4F7FA" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#006CE0" Offset="0" />
        <GradientStop Color="#004BA0" Offset="1" />
      </LinearGradientBrush>
      <!-- Shared brushes are mutated, never replaced after native templates load. -->
      <SolidColorBrush x:Key="PageSurfaceBrush" Color="#D8CCD5DE" />
      <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#F8FFFFFF" />
      <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#E8E3EAF0" />
      <SolidColorBrush x:Key="SectionSurfaceBrush" Color="#EDF1F5" />
      <SolidColorBrush x:Key="SoftPanelBrush" Color="#E5EBF0" />
      <SolidColorBrush x:Key="PanelStrokeBrush" Color="#70808B96" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#172025" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="AppAccentTextBrush" Color="#0057B8" />
      <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppSelectionBrush" Color="#22006CE0" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="#FFF4CE" />
      <SolidColorBrush x:Key="MetricAreaBrush" Color="#087E74" />
      <SolidColorBrush x:Key="MetricMaterialBrush" Color="#63737D" />
      <SolidColorBrush x:Key="MetricPayrollBrush" Color="#97600F" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#A0FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E0FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B8E5ECF0" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#38808B96" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#68808B96" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#D8FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F0FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#48808B96" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#70808B96" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#006CE0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#006CE0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#006CE0" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#006CE0" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ComboBoxItemSelectionIndicatorBrush" Color="#006CE0" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#22006CE0" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#22006CE0" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#22006CE0" />
      <AcrylicBrush x:Key="GlassChromeBrush" TintColor="#F4F7F9" TintOpacity="0.7" TintLuminosityOpacity="0.85" FallbackColor="#F4F7F9" />
      <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0.75,1">
        <GradientStop Color="#DCFFFFFF" Offset="0" />
        <GradientStop Color="#40798490" Offset="0.45" />
        <GradientStop Color="#10808A94" Offset="0.75" />
        <GradientStop Color="#A0FFFFFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="MetricSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8FFFFFF" Offset="0" />
        <GradientStop Color="#A8EDF2F5" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90FFFFFF" Offset="0" />
        <GradientStop Color="#08000000" Offset="0.4" />
        <GradientStop Color="#28000000" Offset="1" />
      </LinearGradientBrush>
    <Style x:Key="AppTitleTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CardTitleTextBlockStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.82" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PaneSurfaceStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PaneGlassBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SidebarSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PaneSurfaceStyle}">
      <Setter Property="Background" Value="{StaticResource SidebarSurfaceBrush}" />
    </Style>
    <Style x:Key="SettingsSectionStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SectionSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="MetricSurfaceStyle" TargetType="Border" BasedOn="{StaticResource PaneSurfaceStyle}">
      <Setter Property="Background" Value="{StaticResource MetricSurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="ListSurfaceStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SoftPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AppOnAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style x:Key="IconTextButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="TopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource IconTextButtonStyle}">
      <Setter Property="Width" Value="86" />
      <Setter Property="Height" Value="76" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AccentTopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource AppOnAccentBrush}" />
    </Style>
    <Style x:Key="SettingsTopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
      <Setter Property="Width" Value="86" />
    </Style>
    <Style x:Key="AccentSettingsTopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentTopNavButtonStyle}">
      <Setter Property="Width" Value="86" />
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
