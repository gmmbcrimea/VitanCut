                      <Grid>
                      <Expander Header="{Binding Name}" AutomationProperties.Name="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Visibility="{Binding GroupVisibility}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
