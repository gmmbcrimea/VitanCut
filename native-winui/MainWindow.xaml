g="yellow" AutomationProperties.Name="Жёлтая палитра" ToolTipService.ToolTip="Жёлтая палитра" Click="CutColorClick" Width="42" Height="42" Background="#FFD166" l10n:UiLocalization.Properties="AutomationProperties.Name,ToolTipService.ToolTip"/><Button Tag="orange" AutomationProperties.Name="Оранжевая палитра" ToolTipService.ToolTip="Оранжевая палитра" Click="CutColorClick" Width="42" Height="42" Background="#EF8354" l10n:UiLocalization.Properties="AutomationProperties.Name,ToolTipService.ToolTip"/><Button Tag="purple" AutomationProperties.Name="Фиолетовая палитра" ToolTipService.ToolTip="Фиолетовая палитра" Click="CutColorClick" Width="42" Height="42" Background="#B487E8" l10n:UiLocalization.Properties="AutomationProperties.Name,ToolTipService.ToolTip"/></StackPanel></StackPanel></Grid></Border></StackPanel>
