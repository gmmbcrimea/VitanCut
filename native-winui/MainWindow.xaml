    <InfoBar x:Name="AppInfoBar" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,18,24,0" IsClosable="True" IsOpen="False" Severity="Success" Canvas.ZIndex="1000" />
  </Grid>
