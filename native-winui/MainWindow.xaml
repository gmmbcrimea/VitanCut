<Window
    x:Class="VitanCut.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services"
    xmlns:models="using:VitanCut.WinUI.Models"
    Title="Расчёт мебели">

  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" Background="{StaticResource GlassChromeBrush}">
    <Grid.Resources>
      <DataTemplate x:Key="MaterialChoiceTemplate">
        <TextBlock Text="{Binding Material.Name}" Padding="8,6" TextTrimming="CharacterEllipsis" />
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="104" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="VITAN-CUT" FontWeight="Bold"/><TextBlock Text="Расчёт мебели" Opacity="0.65" l10n:UiLocalization.Properties="Text"/></StackPanel>
      <Grid x:Name="TitleDragRegion" Grid.Column="2" />
    </Grid>

    <Border Grid.Row="1" Background="Transparent">
      <Grid Padding="8,12" RowSpacing="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image Width="80" Height="64" Source="Assets/logo.png" Stretch="Uniform" />
        <StackPanel Grid.Row="1" Spacing="10">
          <Button x:Name="ProjectsTabButton" Content="Проекты" Tag="projects" Click="TopTabClick" Style="{StaticResource TopNavButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
          <Button x:Name="CustomersTabButton" Content="Каталог" Tag="customers" Click="TopTabClick" Style="{StaticResource TopNavButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
          <Button x:Name="MaterialsTabButton" Content="Материалы" Tag="materials" Click="TopTabClick" Style="{StaticResource TopNavButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
          <Button x:Name="CatalogTabButton" Content="Каталог" Tag="catalog" Click="TopTabClick" Style="{StaticResource TopNavButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
        </StackPanel>

        <Button x:Name="SettingsTabButton"
                Grid.Row="2"
                Tag="settings"
                Click="TopTabClick"
                Style="{StaticResource SettingsTopNavButtonStyle}"
                ToolTipService.ToolTip="Настройки" l10n:UiLocalization.Properties="ToolTipService.ToolTip">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Setting" />
            <TextBlock Text="Настройки"  l10n:UiLocalization.Properties="Text"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid x:Name="ContentHost" Grid.Row="1" Grid.Column="1" Padding="16,8,16,16">
      <Grid x:Name="ProjectsPage" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ProjectListPane" Style="{StaticResource SidebarSurfaceStyle}" Shadow="{StaticResource SurfaceShadow}" Translation="0,0,12">
          <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Проекты" Style="{StaticResource SectionTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>

            <Grid Grid.Row="1" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Сортировка" VerticalAlignment="Center" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <ComboBox x:Name="SortBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="SortChanged"
                        SelectedIndex="1">
                <ComboBoxItem Content="Дата создания" Tag="created"  l10n:UiLocalization.Properties="Content"/>
                <ComboBoxItem Content="Дата изменения" Tag="updated"  l10n:UiLocalization.Properties="Content"/>
                <ComboBoxItem Content="Имя" Tag="name"  l10n:UiLocalization.Properties="Content"/>
                <ComboBoxItem Content="Заказчик" Tag="counterparty"  l10n:UiLocalization.Properties="Content"/>
              </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
              <Border Style="{StaticResource ListSurfaceStyle}">
                <ListView x:Name="ProjectsList"
                          SelectionMode="Single"
                          SelectionChanged="ProjectsSelectionChanged"
                          RightTapped="ListViewRightTappedSelectItem" IsRightTapEnabled="True">
                  <ListView.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem Text="Добавить" Click="AddProjectClick"  l10n:UiLocalization.Properties="Text"/>
                      <MenuFlyoutItem Text="Изменить" Click="EditProjectClick"  l10n:UiLocalization.Properties="Text"/>
                      <MenuFlyoutItem Text="Удалить" Click="DeleteProjectClick"  l10n:UiLocalization.Properties="Text"/>
                    </MenuFlyout>
                  </ListView.ContextFlyout>
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Project">
                      <Grid Padding="12" RowSpacing="4">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Counterparty}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{x:Bind Address}" Opacity="0.56" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>

              <StackPanel x:Name="NoProjectsPanel"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="240"
                          Spacing="10">
                <TextBlock Text="Проектов пока нет" Style="{StaticResource CardTitleTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
                <TextBlock Text="Создайте первый проект для расчета." Style="{StaticResource MutedTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
              </StackPanel>
            </Grid>

            <Button Grid.Row="3"
                    Content="Создать проект"
                    Click="AddProjectClick"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"  l10n:UiLocalization.Properties="Content"/>
          </Grid>
        </Border>

        <Border x:Name="ProjectDetailPane" Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}">
          <Grid Padding="28">
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="440"
                        Spacing="12">
              <TextBlock Text="Выберите проект" Style="{StaticResource SectionTitleTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock Text="Справа появятся данные проекта, итоговые значения, изделия и добавленная зарплата."
                         TextAlignment="Center"
                         Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
            </StackPanel>

            <ScrollViewer x:Name="ProjectPanel" Visibility="Collapsed" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="24">
                <Button x:Name="BackToProjectsButton"
                        Content="Назад к проектам"
                        Click="BackToProjectsClick"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"  l10n:UiLocalization.Properties="Content"/>

                <Grid ColumnSpacing="16" RowSpacing="16">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Spacing="4">
                    <TextBlock x:Name="ProjectTitleText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProjectCustomerText" FontSize="15" Opacity="0.82" />
                    <TextBlock x:Name="ProjectAddressText" FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                              Orientation="Horizontal"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Spacing="8">
                    <Button Content="Создать деталировку"
                            Click="CreateDetailingClick"  l10n:UiLocalization.Properties="Content"/>
                    <Button Content="Сводная таблица" Click="CreateMaterialSummaryClick" l10n:UiLocalization.Properties="Content"/>
                    <Button Content="Создать карту кроя"
                            Click="CreateCutMapClick"
                            Style="{StaticResource AccentButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
                  </StackPanel>
                </Grid>

                <Grid x:Name="MetricsGrid" ColumnSpacing="12" RowSpacing="12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="MetricAreaCard" Style="{StaticResource MetricSurfaceStyle}" Padding="14" BorderBrush="{StaticResource MetricAreaBrush}" BorderThickness="0,0,3,0">
                    <StackPanel>
                      <Grid ColumnSpacing="8" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Crop" Foreground="{StaticResource MetricAreaBrush}"/><TextBlock Grid.Column="1" Text="Общая квадратура" Style="{StaticResource MutedTextBlockStyle}" VerticalAlignment="Center"  l10n:UiLocalization.Properties="Text"/></Grid>
                      <TextBlock x:Name="MetricAreaText" FontSize="26" FontWeight="SemiBold" />
                      <TextBlock Text="м²" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="MetricMaterialsCard" Grid.Column="1" Style="{StaticResource MetricSurfaceStyle}" Padding="14" BorderBrush="{StaticResource MetricMaterialBrush}" BorderThickness="0,0,3,0">
                    <StackPanel>
                      <Grid ColumnSpacing="8" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Library" Foreground="{StaticResource MetricMaterialBrush}"/><TextBlock Grid.Column="1" Text="Себестоимость материалов" Style="{StaticResource MutedTextBlockStyle}" VerticalAlignment="Center"  l10n:UiLocalization.Properties="Text"/></Grid>
                      <TextBlock x:Name="MetricMaterialsText" FontSize="26" FontWeight="SemiBold" />
                      <TextBlock Text="руб." Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="MetricPayrollCard" Grid.Column="2" Style="{StaticResource MetricSurfaceStyle}" Padding="14" BorderBrush="{StaticResource MetricPayrollBrush}" BorderThickness="0,0,3,0">
                    <StackPanel>
                      <Grid ColumnSpacing="8" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Contact" Foreground="{StaticResource MetricPayrollBrush}"/><TextBlock Grid.Column="1" Text="Сумма ЗП" Style="{StaticResource MutedTextBlockStyle}" VerticalAlignment="Center"  l10n:UiLocalization.Properties="Text"/></Grid>
                      <TextBlock x:Name="MetricPayrollText" FontSize="26" FontWeight="SemiBold" />
                      <TextBlock Text="руб." Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
                    </StackPanel>
                  </Border>
                  <Border x:Name="MetricTotalCard" Grid.Column="3" Style="{StaticResource MetricSurfaceStyle}" Padding="14" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource AccentEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                      <Grid ColumnSpacing="8" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Calculator" Foreground="{StaticResource AppOnAccentBrush}"/><TextBlock Grid.Column="1" Text="Общая стоимость" Foreground="{StaticResource AppOnAccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center"  l10n:UiLocalization.Properties="Text"/></Grid>
                      <TextBlock x:Name="MetricTotalText" Foreground="{StaticResource AppOnAccentBrush}" FontSize="26" FontWeight="SemiBold" />
                      <TextBlock Text="руб." Foreground="{StaticResource AppOnAccentBrush}"  l10n:UiLocalization.Properties="Text"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid x:Name="ProjectWorkListsGrid" ColumnSpacing="16" RowSpacing="12" MaxHeight="540">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid RowSpacing="10" MinHeight="360">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Изделия" Style="{StaticResource CardTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
                  <Grid Grid.Row="1" MinHeight="360">
                    <Border Style="{StaticResource ListSurfaceStyle}">
                      <ListView x:Name="ProductsList"
                                MaxHeight="360"
                                DoubleTapped="ProductsListDoubleTapped"
                                RightTapped="ListViewRightTappedSelectItem"
                                IsRightTapEnabled="True"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ContextFlyout>
                          <MenuFlyout>
                            <MenuFlyoutItem Text="Добавить" Click="AddProductClick"  l10n:UiLocalization.Properties="Text"/>
                            <MenuFlyoutItem Text="Изменить" Click="EditProductClick"  l10n:UiLocalization.Properties="Text"/>
                            <MenuFlyoutItem Text="Удалить" Click="DeleteProductClick"  l10n:UiLocalization.Properties="Text"/>
                          </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                          <DataTemplate x:DataType="models:Product">
                            <Grid Padding="12,8" ColumnSpacing="10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Image Width="56" Height="56" Stretch="Uniform" Tag="{x:Bind Image}" Loaded="ProductThumbnailLoaded" />
                              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SizeText}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                    </Border>
                    <StackPanel x:Name="NoProductsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                      <TextBlock Text="Изделий пока нет" Style="{StaticResource CardTitleTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
                      <TextBlock Text="Добавьте изделие, чтобы начать деталировку." Style="{StaticResource MutedTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
                    </StackPanel>
                  </Grid>
                  <Button Grid.Row="2" Content="Добавить изделие" Click="AddProductClick" HorizontalAlignment="Left"  l10n:UiLocalization.Properties="Content"/>
                </Grid>

                <Grid x:Name="PayrollPanel" Grid.Column="1" RowSpacing="10" MinHeight="360">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="ЗП" Style="{StaticResource CardTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
                  <Grid Grid.Row="1" MinHeight="360">
                    <Border Style="{StaticResource ListSurfaceStyle}">
                      <ListView x:Name="PayrollsList"
                                MaxHeight="360"
                                RightTapped="ListViewRightTappedSelectItem"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ContextFlyout>
                          <MenuFlyout>
                            <MenuFlyoutItem Text="Добавить" Click="AddPayrollClick"  l10n:UiLocalization.Properties="Text"/>
                            <MenuFlyoutItem Text="Изменить" Click="EditPayrollClick"  l10n:UiLocalization.Properties="Text"/>
                            <MenuFlyoutItem Text="Удалить" Click="DeletePayrollClick"  l10n:UiLocalization.Properties="Text"/>
                          </MenuFlyout>
                        </ListView.ContextFlyout>
                      </ListView>
                    </Border>
                    <StackPanel x:Name="NoPayrollsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                      <TextBlock Text="ЗП пока не добавлена" Style="{StaticResource CardTitleTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
                      <TextBlock Text="Добавьте строку зарплаты для проекта." Style="{StaticResource MutedTextBlockStyle}" TextAlignment="Center"  l10n:UiLocalization.Properties="Text"/>
                    </StackPanel>
                  </Grid>
                  <Button Grid.Row="2" Content="Добавить ЗП" Click="AddPayrollClick" HorizontalAlignment="Left"  l10n:UiLocalization.Properties="Content"/>
                </Grid>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="CustomersPage" Visibility="Collapsed" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource PaneSurfaceStyle}">
          <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Заказчики" Style="{StaticResource SectionTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
            <Border Grid.Row="1" Style="{StaticResource ListSurfaceStyle}">
              <ListView x:Name="CustomersList" SelectionChanged="CustomersSelectionChanged" RightTapped="ListViewRightTappedSelectItem" IsRightTapEnabled="True">
                <ListView.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="Добавить" Click="AddCustomerClick"  l10n:UiLocalization.Properties="Text"/>
                    <MenuFlyoutItem Text="Изменить" Click="EditCustomerClick"  l10n:UiLocalization.Properties="Text"/>
                    <MenuFlyoutItem Text="Удалить" Click="DeleteCustomerClick"  l10n:UiLocalization.Properties="Text"/>
                  </MenuFlyout>
                </ListView.ContextFlyout>
              </ListView>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
              <Button Content="Добавить" Click="AddCustomerClick" Style="{StaticResource AccentButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
              <Button Content="Удалить" Click="DeleteCustomerClick"  l10n:UiLocalization.Properties="Content"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}">
          <Grid Padding="20" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock x:Name="CustomerProjectsTitle" Text="Изделия заказчика" Style="{StaticResource SectionTitleTextBlockStyle}" TextWrapping="Wrap"  l10n:UiLocalization.Properties="Text"/>
                <TextBlock x:Name="CustomerProjectsSubtitle" Text="Выберите заказчика слева." Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap"  l10n:UiLocalization.Properties="Text"/>
              </StackPanel>
              <Button x:Name="AddCatalogProductButton" Grid.Column="1" VerticalAlignment="Top" Click="AddCatalogProductClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Добавить изделие в каталог" l10n:UiLocalization.Properties="AutomationProperties.Name">
                <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock Text="Добавить изделие" l10n:UiLocalization.Properties="Text"/></StackPanel>
              </Button>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource ListSurfaceStyle}">
              <ListView x:Name="CustomerProjectsList"
                        DoubleTapped="CustomerProjectsDoubleTapped"
                        RightTapped="ListViewRightTappedSelectItem" IsRightTapEnabled="True">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="models:CustomerProductItem">
                    <Grid Padding="12" ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Image Width="56" Height="56" Stretch="Uniform" Tag="{x:Bind Product.Image}" Loaded="ProductThumbnailLoaded" />
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ProjectName}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind SizeText}" Opacity="0.56" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="MaterialsPage" Visibility="Collapsed" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="MaterialCategoriesColumn" Width="200" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition x:Name="MaterialListColumn" Width="280" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource PaneSurfaceStyle}">
          <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Категории" Style="{StaticResource SectionTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
            <Border Grid.Row="1" Style="{StaticResource ListSurfaceStyle}">
              <ListView x:Name="MaterialCategoriesList" SelectionChanged="MaterialCategoriesSelectionChanged" />
            </Border>
          </Grid>
        </Border>
        <Button x:Name="MaterialCategoriesSplitter" Grid.Column="1" Tag="splitter" Style="{StaticResource MaterialSplitterStyle}" AutomationProperties.Name="Ширина категорий" ToolTipService.ToolTip="Ширина категорий" KeyDown="MaterialSplitterKeyDown" l10n:UiLocalization.Properties="AutomationProperties.Name,ToolTipService.ToolTip">
          <Border Width="2" Height="42" Background="#7B8793" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
        <Border Grid.Column="2" Style="{StaticResource PaneSurfaceStyle}">
          <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Материалы" Style="{StaticResource SectionTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
            <Grid Grid.Row="1" RowSpacing="8">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox x:Name="MaterialSortBox" Header="Сортировка" SelectionChanged="MaterialSortChanged" SelectedIndex="0"
                          HorizontalAlignment="Stretch" l10n:UiLocalization.Properties="Header">
                  <ComboBoxItem Content="Название А–Я" Tag="name-asc"  l10n:UiLocalization.Properties="Content"/>
                  <ComboBoxItem Content="Название Я–А" Tag="name-desc"  l10n:UiLocalization.Properties="Content"/>
                  <ComboBoxItem Content="Дата добавления" Tag="date"  l10n:UiLocalization.Properties="Content"/>
                </ComboBox>
                <ComboBox x:Name="MaterialGroupActionBox" Grid.Row="1" Header="Действие с выделением"
                          Visibility="Collapsed" SelectionChanged="MaterialGroupActionChanged" HorizontalAlignment="Stretch" l10n:UiLocalization.Properties="Header">
                  <ComboBoxItem Content="Выберите действие" Tag="none"  l10n:UiLocalization.Properties="Content"/>
                  <ComboBoxItem Content="Объединить в группу..." Tag="merge"  l10n:UiLocalization.Properties="Content"/>
                  <ComboBoxItem Content="Убрать из группы" Tag="ungroup"  l10n:UiLocalization.Properties="Content"/>
                </ComboBox>
              </Grid>
              <Border Grid.Row="1" Style="{StaticResource ListSurfaceStyle}">
                <Grid>
                  <ListView x:Name="MaterialsList" PreviewKeyDown="MaterialListKeyDown" SelectionMode="Extended" SelectionChanged="MaterialsSelectionChanged" ItemClick="MaterialItemClicked" IsItemClickEnabled="True"
                            RightTapped="ListViewRightTappedSelectItem" IsRightTapEnabled="True">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Material.Name}" Padding="8,6" />
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                  <ListView x:Name="GroupedMaterialsList" Visibility="Collapsed" SelectionChanged="MaterialsSelectionChanged"
                            RightTapped="ListViewRightTappedSelectItem" IsRightTapEnabled="True">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0" />
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
