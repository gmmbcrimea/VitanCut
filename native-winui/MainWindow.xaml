нные." Foreground="#B8B8B8" TextWrapping="Wrap" l10n:UiLocalization.Properties="Text"/><Grid x:Name="CloudLoginGrid" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CloudEmailBox" Header="Email" PlaceholderText="name@company.ru" InputScope="EmailSmtpAddress"/><PasswordBox x:Name="CloudPasswordBox" Grid.Column="1" Header="Пароль" PasswordRevealMode="Peek" l10n:UiLocalization.Properties="Header"/><Button x:Name="CloudSignInButton" Grid.Column="2" Content="Войти" Background="#3ECF8E" Foreground="#101010" VerticalAlignment="Bottom" Click="CloudSignInClick" l10n:UiLocalization.Properties="Content"/></Grid><ProgressBar x:Name="CloudOperationProgress" Visibility="Collapsed" IsIndeterminate="False" AutomationProperties.Name="Синхронизация с облаком" l10n:UiLocalization.Properties="AutomationProperties.Name"/><Border x:Name="CloudStatusBadge" Background="#242424" BorderBrush="#3ECF8E" BorderThickness="1" CornerRadius="8" Padding="12,9"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Пространство" Foreground="#AFAFAF" l10n:UiLocalization.Properties="Text"/><TextBlock Text="Cutlist" Foreground="#F5F5F5" FontWeight="SemiBold"/></StackPanel></Border><StackPanel x:Name="CloudActionsPanel" Orientation="Horizontal" Spacing="8"><Button Content="Загрузить из облака" Click="DownloadCloudDatabaseClick" l10n:UiLocalization.Properties="Content"/><Button Content="Опубликовать изменения" Background="#3ECF8E" Foreground="#101010" Click="PublishCloudDatabaseClick" l10n:UiLocalization.Properties="Content"/></StackPanel><TextBlock x:Name="CloudSyncStatusText" AutomationProperties.LiveSetting="Polite" Foreground="#AFAFAF" TextWrapping="Wrap"/></StackPanel></Border><InfoBar x:Name="DatabaseInfoBar" IsOpen="False" IsClosable="True" /></StackPanel>
</StackPanel></Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
