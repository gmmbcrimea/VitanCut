                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>
                      </Expander>
                      <ListView ItemsSource="{Binding Items}" PreviewKeyDown="MaterialListKeyDown" Visibility="{Binding PlainVisibility}" SelectionMode="Extended" ItemTemplate="{StaticResource MaterialChoiceTemplate}"
                                SelectionChanged="MaterialGroupSelectionChanged" ItemClick="MaterialItemClicked" IsItemClickEnabled="True"
                                RightTapped="ListViewRightTappedSelectItem" IsRightTapEnabled="True" />
