<Window
    x:Class="VitanCut.WinUI.Views.ProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services"
    Title="Vitan-Cut - Изделие">

  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" Background="{StaticResource PageSurfaceBrush}" SizeChanged="RootSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Button x:Name="BackgroundFocusTarget" Width="1" Height="1" MinWidth="0" MinHeight="0" Padding="0" Opacity="0"
                    IsTabStop="False" HorizontalAlignment="Left" VerticalAlignment="Top" />

    <Grid Padding="24,20,24,12" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Name="TitleText" Text="Изделие" Style="{StaticResource SectionTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
        <TextBlock x:Name="SubtitleText" Text="Карточка изделия, размеры, фиксированные размеры и детали" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
      </StackPanel>
      <Border Grid.Column="1"
              MinWidth="250"
              Padding="14,10"
              Style="{StaticResource ListSurfaceStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock x:Name="SummaryAreaText" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="SummaryCostText" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <ScrollViewer x:Name="ProductScrollViewer" Grid.Row="1"
                  Padding="24,0,24,0"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" ViewChanged="ProductScrollViewChanged" SizeChanged="DetailsToolbarSizeChanged">
      <StackPanel Spacing="16">
        <Border x:Name="CatalogPickerCard" Style="{StaticResource PaneSurfaceStyle}" Padding="16">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CatalogProductBox"
                      Header="Выбрать изделие из каталога"
                      PlaceholderText="Готовых изделий для заказчика нет"
                      HorizontalAlignment="Stretch"  l10n:UiLocalization.Properties="Header,PlaceholderText"/>
            <Button Grid.Column="1"
                    Content="Использовать"
                    Click="UseCatalogProductClick"
                    VerticalAlignment="Bottom"  l10n:UiLocalization.Properties="Content"/>
          </Grid>
        </Border>

        <Grid x:Name="ProductSectionsGrid" ColumnSpacing="16" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="ProductCard" Style="{StaticResource PaneSurfaceStyle}" Padding="16">
            <StackPanel Spacing="14">
              <TextBlock Text="Карточка изделия" Style="{StaticResource CardTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBox x:Name="ProductNameBox" Header="Название изделия" TextChanged="ProductFieldChanged"  l10n:UiLocalization.Properties="Header"/>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="Добавить изображение" Click="PickImageClick"  l10n:UiLocalization.Properties="Content"/>
                <TextBlock x:Name="ProductImageStatusText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" />
              </Grid>
              <Image x:Name="ProductImagePreview" Height="144" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />
              <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <NumberBox x:Name="ProductLengthBox" Header="Длина, мм" Minimum="0" ValueChanged="ProductNumberChanged"  l10n:UiLocalization.Properties="Header"/>
                <NumberBox x:Name="ProductDepthBox" Grid.Column="1" Header="Глубина, мм" Minimum="0" ValueChanged="ProductNumberChanged"  l10n:UiLocalization.Properties="Header"/>
                <NumberBox x:Name="ProductHeightBox" Grid.Row="1" Header="Высота, мм" Minimum="0" ValueChanged="ProductNumberChanged"  l10n:UiLocalization.Properties="Header"/>
                <NumberBox x:Name="ProductQtyBox" Grid.Row="1" Grid.Column="1" Header="Кол-во" Minimum="1" SmallChange="1" ValueChanged="ProductNumberChanged"  l10n:UiLocalization.Properties="Header"/>
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="HasLegsBox" Content="Есть ножки" VerticalAlignment="Center" Checked="ProductToggleChanged" Unchecked="ProductToggleChanged"  l10n:UiLocalization.Properties="Content"/>
                <NumberBox x:Name="LegHeightBox" Grid.Column="1" Header="Высота ножки, мм" Minimum="0" ValueChanged="ProductNumberChanged"  Visibility="Collapsed"  l10n:UiLocalization.Properties="Header"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="FixedSizesCard" Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Фиксированные размеры" Style="{StaticResource CardTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <Grid x:Name="FixedSizesGrid" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource PaneSurfaceStyle}" Padding="16">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="DetailsToolbarHeader" ColumnSpacing="12" SizeChanged="DetailsToolbarSizeChanged">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Детали" Style="{StaticResource CardTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <Grid x:Name="DetailsActionsSlot" Grid.Column="1">
              <StackPanel x:Name="DetailsActionsPanel" Orientation="Horizontal" Spacing="8">
                <Button Content="Добавить" Click="AddDetailClick" Style="{StaticResource AccentButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
                <Button Content="Удалить" Click="DeleteDetailClick"  l10n:UiLocalization.Properties="Content"/>
              </StackPanel>
              </Grid>
            </Grid>

            <Grid x:Name="DetailsTableViewport" Grid.Row="1" Grid.RowSpan="2"
                  SizeChanged="DetailsTableViewportSizeChanged">
            <Grid x:Name="DetailsTable" RowSpacing="12">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="DetailsHorizontalOffset" />
              </Grid.RenderTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
            <Border Margin="5,0" Padding="8" BorderThickness="1" BorderBrush="Transparent">
            <Grid x:Name="DetailsHeaderGrid" ColumnSpacing="10" SizeChanged="DetailsHeaderSizeChanged">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Деталь" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock Grid.Column="1" Text="Материал" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock Grid.Column="2" Text="Кол-во" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock x:Name="DetailLengthHeader" Grid.Column="3" Text="Длина / формула" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock x:Name="DetailWidthHeader" Grid.Column="5" Text="Ширина / формула" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock x:Name="DetailRotationHeader" Grid.Column="6" Text="Поворот детали" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
              <TextBlock Grid.Column="7" Text="Расчет" Style="{StaticResource MutedTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
            </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ListSurfaceStyle}" BorderThickness="1" Padding="0">
              <ItemsRepeater x:Name="DetailsRowsPanel" Margin="4" VerticalCacheLength="0.5"
                             ElementPrepared="DetailElementPrepared" ElementClearing="DetailElementClearing">
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate>
                    <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False" />
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Border>
            </Grid>
            </Grid>
            <ScrollBar x:Name="DetailsHorizontalScroll" Grid.Row="3" Orientation="Horizontal" Visibility="Collapsed"
                       ValueChanged="DetailsHorizontalScrollChanged" SmallChange="40" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="StickyDetailsToolbar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
            Margin="24,0,24,0" Padding="16,8" CornerRadius="6" Visibility="Collapsed"
            Background="{StaticResource SectionSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" SizeChanged="StickyDetailsToolbarSizeChanged">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Детали" Style="{StaticResource CardTitleTextBlockStyle}" VerticalAlignment="Center" l10n:UiLocalization.Properties="Text" />
        <Grid x:Name="StickyDetailsActionsSlot" Grid.Column="1" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="24,14"
            Background="{StaticResource GlassChromeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Отмена" Click="CancelClick"  l10n:UiLocalization.Properties="Content"/>
        <Button Content="Сохранить" Click="SaveClick" Style="{StaticResource AccentButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
