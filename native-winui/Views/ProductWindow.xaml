<Window
    x:Class="VitanCut.WinUI.Views.ProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vitan-Cut - Изделие">

  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" Background="{StaticResource PageSurfaceBrush}" SizeChanged="RootSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Padding="24,20,24,12" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Name="TitleText" Text="Изделие" Style="{StaticResource SectionTitleTextBlockStyle}" />
        <TextBlock x:Name="SubtitleText" Text="Карточка изделия, размеры, фиксированные размеры и детали" Style="{StaticResource MutedTextBlockStyle}" />
      </StackPanel>
      <Border Grid.Column="1"
              MinWidth="250"
              Padding="14,10"
              Style="{StaticResource ListSurfaceStyle}">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock x:Name="SummaryAreaText" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="SummaryCostText" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  Padding="24,0,24,0"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
      <StackPanel Spacing="16">
        <Border x:Name="CatalogPickerCard" Style="{StaticResource PaneSurfaceStyle}" Padding="16">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CatalogProductBox"
                      Header="Выбрать изделие из каталога"
                      PlaceholderText="Готовых изделий для заказчика нет"
                      HorizontalAlignment="Stretch" />
            <Button Grid.Column="1"
                    Content="Использовать"
                    Click="UseCatalogProductClick"
                    VerticalAlignment="Bottom" />
          </Grid>
        </Border>

        <Grid x:Name="ProductSectionsGrid" ColumnSpacing="16" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="ProductCard" Style="{StaticResource PaneSurfaceStyle}" Padding="16">
            <StackPanel Spacing="14">
              <TextBlock Text="Карточка изделия" Style="{StaticResource CardTitleTextBlockStyle}" />
              <TextBox x:Name="ProductNameBox" Header="Название изделия" TextChanged="ProductFieldChanged" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="Добавить изображение" Click="PickImageClick" />
                <TextBlock x:Name="ProductImageStatusText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" />
              </Grid>
              <Image x:Name="ProductImagePreview" Height="144" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" />
              <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <NumberBox x:Name="ProductLengthBox" Header="Длина, мм" Minimum="0" ValueChanged="ProductNumberChanged" />
                <NumberBox x:Name="ProductDepthBox" Grid.Column="1" Header="Глубина, мм" Minimum="0" ValueChanged="ProductNumberChanged" />
                <NumberBox x:Name="ProductHeightBox" Grid.Row="1" Header="Высота, мм" Minimum="0" ValueChanged="ProductNumberChanged" />
                <NumberBox x:Name="ProductQtyBox" Grid.Row="1" Grid.Column="1" Header="Кол-во" Minimum="1" SmallChange="1" ValueChanged="ProductNumberChanged" />
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="HasLegsBox" Content="Есть ножки" VerticalAlignment="Center" Checked="ProductToggleChanged" Unchecked="ProductToggleChanged" />
                <NumberBox x:Name="LegHeightBox" Grid.Column="1" Header="Высота ножки, мм" Minimum="0" ValueChanged="ProductNumberChanged"  Visibility="Collapsed" />
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="FixedSizesCard" Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Фиксированные размеры" Style="{StaticResource CardTitleTextBlockStyle}" />
              <Grid x:Name="FixedSizesGrid" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource PaneSurfaceStyle}" Padding="16">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Детали" Style="{StaticResource CardTitleTextBlockStyle}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Добавить" Click="AddDetailClick" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Удалить" Click="DeleteDetailClick" />
              </StackPanel>
            </Grid>

            <ScrollViewer x:Name="DetailsTableViewport" Grid.Row="1" Grid.RowSpan="2"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          SizeChanged="DetailsTableViewportSizeChanged">
            <Grid x:Name="DetailsTable" RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="360" />
              </Grid.RowDefinitions>
            <Border Margin="5,0" Padding="8" BorderThickness="1" BorderBrush="Transparent">
            <Grid x:Name="DetailsHeaderGrid" ColumnSpacing="10" SizeChanged="DetailsHeaderSizeChanged">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Деталь" Style="{StaticResource MutedTextBlockStyle}" />
              <TextBlock Grid.Column="1" Text="Материал" Style="{StaticResource MutedTextBlockStyle}" />
              <TextBlock Grid.Column="2" Text="Кол-во" Style="{StaticResource MutedTextBlockStyle}" />
              <TextBlock x:Name="DetailLengthHeader" Grid.Column="3" Text="Длина / формула" Style="{StaticResource MutedTextBlockStyle}" />
              <TextBlock x:Name="DetailWidthHeader" Grid.Column="4" Text="Ширина / формула" Style="{StaticResource MutedTextBlockStyle}" />
              <TextBlock x:Name="DetailRotationHeader" Grid.Column="5" Text="Поворот детали" Style="{StaticResource MutedTextBlockStyle}" />
              <TextBlock Grid.Column="6" Text="Расчет" Style="{StaticResource MutedTextBlockStyle}" />
            </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ListSurfaceStyle}" BorderThickness="1" Padding="0">
              <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailsRowsPanel" Padding="4" Spacing="4" />
              </ScrollViewer>
            </Border>
            </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="24,14"
            Background="{StaticResource GlassChromeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Отмена" Click="CancelClick" />
        <Button Content="Сохранить" Click="SaveClick" Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
