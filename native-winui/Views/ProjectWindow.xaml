<Window
    x:Class="VitanCut.WinUI.Views.ProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Проект">

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource WindowPagePadding}" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="ProjectTitle" Text="Проект" Style="{StaticResource SectionTitleTextBlockStyle}" />
        <TextBlock x:Name="ProjectSubtitle" Text="Изделия, деталировка и расчет" Style="{StaticResource MutedTextBlockStyle}" />
      </StackPanel>
      <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent">
        <AppBarButton Icon="Add" Label="Изделие" Click="AddProductClick" />
        <AppBarButton Icon="Delete" Label="Удалить" Click="DeleteProductClick" />
        <AppBarButton Icon="Save" Label="Сохранить" Click="SaveClick" />
      </CommandBar>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource PaneSurfaceStyle}">
        <Grid Padding="16" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Изделия" Style="{StaticResource CardTitleTextBlockStyle}" />
          <ListView x:Name="ProductsList" Grid.Row="1" SelectionChanged="ProductsSelectionChanged" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}">
        <Grid Padding="16" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Детали изделия" Style="{StaticResource CardTitleTextBlockStyle}" />
          <ListView x:Name="DetailsList" Grid.Row="1" SelectionChanged="DetailsSelectionChanged" />
          <CommandBar Grid.Row="2" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Add" Label="Деталь" Click="AddDetailClick" />
            <AppBarButton Icon="Delete" Label="Удалить" Click="DeleteDetailClick" />
          </CommandBar>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource PaneSurfaceStyle}">
        <ScrollViewer>
          <StackPanel Padding="20" Spacing="16">
            <InfoBar x:Name="SummaryBar" IsOpen="True" Severity="Informational" />

            <Expander Header="Карточка изделия" IsExpanded="True">
              <Grid ColumnSpacing="12" RowSpacing="12" Padding="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProductNameBox" Header="Название" />
                <NumberBox x:Name="ProductLengthBox" Grid.Column="1" Header="Длина" />
                <NumberBox x:Name="ProductDepthBox" Grid.Column="2" Header="Глубина" />
                <NumberBox x:Name="ProductHeightBox" Grid.Column="3" Header="Высота" />
                <NumberBox x:Name="ProductQtyBox" Grid.Column="4" Header="Кол-во" />
              </Grid>
            </Expander>

            <Expander Header="Карточка детали" IsExpanded="True">
              <StackPanel Spacing="12" Padding="0,12,0,0">
                <TextBox x:Name="DetailNameBox" Header="Название" />
                <ComboBox x:Name="MaterialBox" Header="Материал" MinWidth="420" />
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="DetailLengthBox" Header="Длина / формула" />
                  <TextBox x:Name="DetailWidthBox" Grid.Column="1" Header="Ширина / формула" />
                  <NumberBox x:Name="DetailQtyBox" Grid.Column="2" Header="Кол-во" />
                </Grid>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
