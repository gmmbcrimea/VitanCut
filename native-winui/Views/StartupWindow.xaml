<Window
    x:Class="VitanCut.WinUI.Views.StartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services"
    Title="VitanCut">
  <Grid Background="Transparent" Padding="28">
    <Image x:Name="Logo" Source="ms-appx:///Assets/logo.png" Width="120" Height="120"
           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
           AutomationProperties.Name="VitanCut" />
    <StackPanel VerticalAlignment="Bottom" Spacing="12">
      <TextBlock x:Name="StatusText" Text="Подготовка приложения…"
                 Style="{StaticResource MutedTextBlockStyle}"
                 TextAlignment="Center" AutomationProperties.LiveSetting="Polite"  l10n:UiLocalization.Properties="Text"/>
      <ProgressBar IsIndeterminate="True" Height="4" AutomationProperties.Name="Запуск приложения"  l10n:UiLocalization.Properties="AutomationProperties.Name"/>
    </StackPanel>
  </Grid>
</Window>
