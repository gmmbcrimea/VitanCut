<Window
    x:Class="VitanCut.WinUI.Views.ReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Расчёт мебели">
  <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" Background="{StaticResource PageSurfaceBrush}">
    <Grid.Resources>
      <Style x:Key="CutTool" TargetType="Button"><Setter Property="Tag" Value="cut-tool"/><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="4"/></Style>
      <Style x:Key="CutToggle" TargetType="ToggleButton"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/></Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource GlassChromeBrush}" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="10">
          <TextBlock Text="VITAN-CUT" FontWeight="SemiBold" Margin="4,8,4,14"/>
          <Button x:Name="SaveReportButton" Content="Сохранить" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
          <Button x:Name="PrintReportButton" Content="Печать" HorizontalAlignment="Stretch"/>
          <StackPanel x:Name="DetailingTools" Spacing="4" Visibility="Collapsed" Margin="0,6,0,0">
            <TextBlock Text="Состав деталировки" FontWeight="SemiBold"/>
            <ToggleSwitch x:Name="DspOnlySwitch" Header="Только материалы ДСП" Toggled="DspOnlyToggled" />
            <TextBlock Text="Выключено: все материалы" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="CutTools" Spacing="10" Visibility="Collapsed">
            <Button x:Name="AdditionalCutButton" HorizontalAlignment="Stretch" Visibility="Collapsed" ToolTipService.ToolTip="ДВП, стекло и другие листовые материалы без «ДСП» в названии">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE81C;" FontSize="16"/><TextBlock Text="Доп. раскрой"/></StackPanel>
            </Button>
            <TextBlock Text="Варианты раскроя" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="CutVariantBox" HorizontalAlignment="Stretch" MinWidth="0"/>
              <Button x:Name="SaveLayoutButton" Grid.Column="1" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Сохранить ручной вариант" AutomationProperties.Name="Сохранить ручной вариант"><FontIcon Glyph="&#xE74E;" FontSize="16"/></Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button x:Name="RotateSelectionButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Повернуть выделенные" AutomationProperties.Name="Повернуть выделенные"><FontIcon Glyph="&#xE7AD;" FontSize="16"/></Button>
              <Button x:Name="MoveSelectionButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Перенести на выбранный лист" AutomationProperties.Name="Перенести на выбранный лист"><FontIcon Glyph="&#xE8DE;" FontSize="16"/></Button>
              <Button x:Name="UndoCutButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Отменить правку" AutomationProperties.Name="Отменить правку"><FontIcon Glyph="&#xE7A7;" FontSize="16"/></Button>
              <Button x:Name="ClearSelectionButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Снять выделение" AutomationProperties.Name="Снять выделение"><FontIcon Glyph="&#xE8F9;" FontSize="16"/></Button>
              <Button x:Name="ResetLayoutButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Сбросить несохранённые правки" AutomationProperties.Name="Сбросить несохранённые правки"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
            </StackPanel>
            <ComboBox x:Name="TargetSheetBox" HorizontalAlignment="Stretch" MinWidth="0" PlaceholderText="Лист назначения" AutomationProperties.Name="Лист назначения"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ToggleButton x:Name="CutLinesSwitch" Style="{StaticResource CutToggle}" IsChecked="True" ToolTipService.ToolTip="Показать линии реза" AutomationProperties.Name="Линии реза"><FontIcon Glyph="&#xE8C6;" FontSize="16"/></ToggleButton>
              <ToggleButton x:Name="RemaindersButton" Style="{StaticResource CutToggle}" ToolTipService.ToolTip="Показать полезные остатки" AutomationProperties.Name="Полезные остатки"><FontIcon Glyph="&#xE91B;" FontSize="16"/></ToggleButton>
              <TextBlock x:Name="SelectionText" Text="Выделено: 0" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <NumberBox x:Name="UsefulRemainderBox" Header="Минимум остатка, мм" Minimum="0" SmallChange="10"/>
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <TextBlock x:Name="CutMetricsText" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" LineHeight="24"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="HintText" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Column="1" Padding="12">
      <Border Style="{StaticResource PaneSurfaceStyle}">
        <ScrollViewer x:Name="ReportScroll" Padding="16" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleTextBlockStyle}"/>
              <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="ContentPanel" Spacing="18"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
