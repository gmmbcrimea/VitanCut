<Window
    x:Class="VitanCut.WinUI.Views.ReportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services"
    Title="Расчёт мебели">
  <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" Background="{StaticResource PageSurfaceBrush}">
    <Grid.Resources>
      <Style x:Key="CutTool" TargetType="Button"><Setter Property="Tag" Value="cut-tool"/><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="4"/></Style>
      <Style x:Key="CutToggle" TargetType="ToggleButton"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/></Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ToggleButton x:Name="ReportToolsToggle" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="12,8,12,0" HorizontalAlignment="Left" Checked="ReportToolsToggled" Unchecked="ReportToolsToggled" AutomationProperties.Name="Показать параметры отчёта" l10n:UiLocalization.Properties="AutomationProperties.Name">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Параметры отчёта" l10n:UiLocalization.Properties="Text"/></StackPanel>
    </ToggleButton>
    <Border x:Name="ReportSidebar" Grid.RowSpan="3" Background="{StaticResource GlassChromeBrush}" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="10">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SaveReportButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.Name="Сохранить отчёт" l10n:UiLocalization.Properties="AutomationProperties.Name">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="16"/><TextBlock Text="Сохранить" Style="{StaticResource CommandLabelStyle}" l10n:UiLocalization.Properties="Text"/></StackPanel>
            </Button>
            <Button x:Name="PrintReportButton" Grid.Column="1" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Печать" AutomationProperties.Name="Печать" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE749;" FontSize="16"/></Button>
          </Grid>
          <StackPanel x:Name="DetailingTools" Spacing="4" Visibility="Collapsed" Margin="0,6,0,0">
            <TextBlock Text="Состав деталировки" FontWeight="SemiBold" l10n:UiLocalization.Properties="Text"/>
            <ToggleSwitch x:Name="DspOnlySwitch" Header="Только материалы ДСП" Toggled="DspOnlyToggled"  l10n:UiLocalization.Properties="Header"/>
            <TextBlock Text="Выключено: все материалы" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" l10n:UiLocalization.Properties="Text"/>
          </StackPanel>
          <StackPanel x:Name="CutTools" Spacing="10" Visibility="Collapsed">
            <Expander Header="Варианты раскладки" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" l10n:UiLocalization.Properties="Header">
            <StackPanel Spacing="8">
            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="CutVariantBox" HorizontalAlignment="Stretch" MinWidth="0"/>
              <Button x:Name="SaveLayoutButton" Grid.Column="1" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Сохранить ручной вариант" AutomationProperties.Name="Сохранить ручной вариант" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE74E;" FontSize="16"/></Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="UndoCutButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Отменить правку" AutomationProperties.Name="Отменить правку" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE7A7;" FontSize="16"/></Button>
              <Button x:Name="ResetLayoutButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Сбросить несохранённые правки" AutomationProperties.Name="Сбросить несохранённые правки" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
            </StackPanel>
            </StackPanel>
            </Expander>
            <Button x:Name="AdditionalCutButton" HorizontalAlignment="Stretch" Visibility="Collapsed" ToolTipService.ToolTip="ДВП, стекло и другие листовые материалы без «ДСП» в названии" l10n:UiLocalization.Properties="ToolTipService.ToolTip">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE81C;" FontSize="16"/><TextBlock Text="Доп. раскрой" l10n:UiLocalization.Properties="Text"/></StackPanel>
            </Button>
            <StackPanel x:Name="SelectionActionsPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="SelectionText" Text="Выделено: 0" FontWeight="SemiBold" l10n:UiLocalization.Properties="Text"/>
            <ComboBox x:Name="TargetSheetBox" Header="Лист назначения" HorizontalAlignment="Stretch" MinWidth="0" PlaceholderText="Выберите лист" AutomationProperties.Name="Лист назначения" l10n:UiLocalization.Properties="Header,PlaceholderText,AutomationProperties.Name"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="RotateSelectionButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Повернуть выделенные" AutomationProperties.Name="Повернуть выделенные" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE7AD;" FontSize="16"/></Button>
              <Button x:Name="MoveSelectionButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Перенести на выбранный лист" AutomationProperties.Name="Перенести на выбранный лист" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE8DE;" FontSize="16"/></Button>
              <Button x:Name="ClearSelectionButton" Style="{StaticResource CutTool}" ToolTipService.ToolTip="Снять выделение" AutomationProperties.Name="Снять выделение" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name"><FontIcon Glyph="&#xE8F9;" FontSize="16"/></Button>
            </StackPanel>
            </StackPanel>
            <Expander Header="Детали на листах" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" l10n:UiLocalization.Properties="Header">
              <ListView x:Name="AccessibleCutParts" SelectionMode="Extended" MaxHeight="200" AutomationProperties.Name="Детали раскроя"  l10n:UiLocalization.Properties="AutomationProperties.Name"/>
            </Expander>
            <ToggleButton x:Name="CutLinesSwitch" Style="{StaticResource CutToggle}" IsChecked="True" ToolTipService.ToolTip="Показать линии реза" AutomationProperties.Name="Линии реза" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C6;" FontSize="16"/><TextBlock Text="Линии реза" Style="{StaticResource CommandLabelStyle}" l10n:UiLocalization.Properties="Text"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="RemaindersButton" Style="{StaticResource CutToggle}" ToolTipService.ToolTip="Показать полезные остатки" AutomationProperties.Name="Полезные остатки" l10n:UiLocalization.Properties="ToolTipService.ToolTip,AutomationProperties.Name">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE91B;" FontSize="16"/><TextBlock Text="Полезные остатки" Style="{StaticResource CommandLabelStyle}" l10n:UiLocalization.Properties="Text"/></StackPanel>
            </ToggleButton>
            <NumberBox x:Name="UsefulRemainderBox" Header="Минимум остатка, мм" Minimum="0" SmallChange="10" Visibility="Collapsed" l10n:UiLocalization.Properties="Header"/>
            <Expander Header="Статистика" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" l10n:UiLocalization.Properties="Header">
              <TextBlock x:Name="CutMetricsText" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" LineHeight="24"/>
            </Expander>
          </StackPanel>
          <TextBlock x:Name="HintText" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid x:Name="ReportBody" Grid.Column="1" Grid.RowSpan="3" Padding="12">
      <Border Style="{StaticResource PaneSurfaceStyle}">
        <ScrollViewer x:Name="ReportScroll" Padding="16" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleTextBlockStyle}"/>
              <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="ContentPanel" Spacing="18"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
