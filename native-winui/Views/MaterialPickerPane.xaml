<UserControl
    x:Class="VitanCut.WinUI.Views.MaterialPickerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services">
  <Grid Padding="12" RowSpacing="8" TabFocusNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Выберите материал" FontWeight="SemiBold" l10n:UiLocalization.Properties="Text" />
    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Поиск материала" MaxLength="200"
             l10n:UiLocalization.Properties="PlaceholderText" />
    <Grid x:Name="Results" Grid.Row="2">
      <ListView x:Name="OptionsList" IsItemClickEnabled="True" SelectionMode="None"
                ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="3,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="30" />
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="3" Margin="0,3" CornerRadius="5" Background="{StaticResource ButtonBackground}"
                      Opacity="{Binding HeadingOpacity}" IsHitTestVisible="False" />
              <Border Width="{Binding Indent}" />
              <StackPanel Grid.Column="1" Margin="10,0,2,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Caption}" Height="{Binding CaptionHeight}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="12" />
              <Border Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,8,0" Height="1" VerticalAlignment="Bottom"
                      Background="{StaticResource PanelStrokeBrush}" Opacity="{Binding DividerOpacity}" IsHitTestVisible="False" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock x:Name="EmptyText" Text="Материалы не найдены" Visibility="Collapsed"
                 IsHitTestVisible="False" l10n:UiLocalization.Properties="Text" />
    </Grid>
    <StackPanel x:Name="Footer" Grid.Row="3" Spacing="6">
      <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource UiDangerBrush}"
                 AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="CancelButton" Content="Отмена" HorizontalAlignment="Right" l10n:UiLocalization.Properties="Content" />
    </StackPanel>
  </Grid>
</UserControl>
