<Window
    x:Class="VitanCut.WinUI.Views.MaterialsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Материалы">

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="{StaticResource WindowPagePadding}" ColumnSpacing="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource PaneSurfaceStyle}">
      <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Материалы" Style="{StaticResource SectionTitleTextBlockStyle}" />
          <TextBlock Text="Листы, фурнитура, кромка и прочие позиции" Style="{StaticResource MutedTextBlockStyle}" />
        </StackPanel>
        <ListView x:Name="MaterialsList" Grid.Row="1" SelectionChanged="MaterialsSelectionChanged" />
      </Grid>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource PaneSurfaceStyle}">
      <StackPanel Padding="20" Spacing="12" MaxWidth="560">
        <CommandBar DefaultLabelPosition="Right" Background="Transparent">
          <AppBarButton Icon="Add" Label="Добавить" Click="AddClick" />
          <AppBarButton Icon="Save" Label="Сохранить" Click="SaveClick" />
          <AppBarButton Icon="Delete" Label="Удалить" Click="DeleteClick" />
        </CommandBar>

        <TextBox x:Name="TypeBox" Header="Тип" />
        <TextBox x:Name="NameBox" Header="Название" />
        <ComboBox x:Name="UnitBox" Header="Единица">
          <ComboBoxItem Content="м²" Tag="m2" />
          <ComboBoxItem Content="пог. м" Tag="lm" />
          <ComboBoxItem Content="шт." Tag="pc" />
        </ComboBox>
        <NumberBox x:Name="CostBox" Header="Цена за единицу" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox x:Name="SheetLengthBox" Header="Длина листа" />
          <NumberBox x:Name="SheetWidthBox" Grid.Column="1" Header="Ширина листа" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
