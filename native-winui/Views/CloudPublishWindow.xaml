<Window
    x:Class="VitanCut.WinUI.Views.CloudPublishWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services"
    Title="Vitan-Cut">
  <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
  <Grid Background="{StaticResource PageSurfaceBrush}" Padding="16">
    <Border Style="{StaticResource PaneSurfaceStyle}" Padding="16">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <FontIcon x:Name="StatusIcon" Glyph="&#xE895;" FontSize="24" Foreground="{StaticResource AppAccentBrush}" />
          <StackPanel Spacing="3">
            <TextBlock x:Name="TitleText" Text="Сохранение в облако" Style="{StaticResource CardTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>
            <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="Публикуем изменённые данные в Supabase..." Style="{StaticResource MutedTextBlockStyle}" TextWrapping="Wrap" MaxWidth="380"  l10n:UiLocalization.Properties="Text"/>
          </StackPanel>
        </StackPanel>
        <ProgressBar x:Name="Progress" AutomationProperties.Name="Сохранение данных в облако" IsIndeterminate="True" Height="8" HorizontalAlignment="Stretch" Margin="0,4,0,0"  l10n:UiLocalization.Properties="AutomationProperties.Name"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
