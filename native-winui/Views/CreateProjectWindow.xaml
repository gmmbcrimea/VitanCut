<Window
    x:Class="VitanCut.WinUI.Views.CreateProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:VitanCut.WinUI.Services"
    Title="Создать проект">

  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Border Background="{StaticResource PageSurfaceBrush}">
    <Grid x:Name="Root"
          Width="500"
          Padding="28"
          RowSpacing="16"
          HorizontalAlignment="Center"
          VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Создать проект" Style="{StaticResource SectionTitleTextBlockStyle}"  l10n:UiLocalization.Properties="Text"/>

      <TextBox x:Name="ProjectNameBox"
               Grid.Row="1"
               Header="Название проекта"
               Text="Новый проект"  l10n:UiLocalization.Properties="Header,Text"/>

      <ComboBox x:Name="CustomerBox"
                Grid.Row="2"
                Header="Выбор заказчика"
                PlaceholderText="Выберите заказчика"
                HorizontalAlignment="Stretch"
                SelectionChanged="CustomerChanged"  l10n:UiLocalization.Properties="Header,PlaceholderText"/>

      <TextBox x:Name="NewCustomerBox"
               Grid.Row="3"
               Header="Новый заказчик"
               PlaceholderText="Введите название заказчика"
               Visibility="Collapsed"  l10n:UiLocalization.Properties="Header,PlaceholderText"/>

      <TextBox x:Name="AddressBox"
               Grid.Row="4"
               Header="Адрес"  l10n:UiLocalization.Properties="Header"/>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Content="Отмена" Click="CancelClick"  l10n:UiLocalization.Properties="Content"/>
        <Button x:Name="CreateButton"
                Content="Создать"
                Click="CreateClick"
                Style="{StaticResource AccentButtonStyle}"  l10n:UiLocalization.Properties="Content"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
